{
  "name": "gooi-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:coherence": "node scripts/check-coherence.mjs",
    "check:deep": "vitest run --config vitest.deep.config.ts",
    "check": "tsc -b && oxlint && vitest run && node scripts/check-coherence.mjs",
    "fetch-osm": "node scripts/fetch-osm.mjs",
    "fetch-timetables": "node scripts/fetch-timetables.mjs",
    "fetch-scenery": "node scripts/fetch-scenery.mjs && node scripts/fetch-demand.mjs",
    "fetch-signals": "node scripts/fetch-signals.mjs",
    "fetch-lanes": "node scripts/fetch-lanes.mjs",
    "data": "node scripts/fetch-osm.mjs && node scripts/fetch-timetables.mjs && node scripts/fetch-scenery.mjs && node scripts/fetch-demand.mjs && node scripts/fetch-signals.mjs && node scripts/fetch-lanes.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
